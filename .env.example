# Repo-root environment template — copy to .env before bringing the stack up:
#
#     cp .env.example .env
#
# Subsystem fragments under each subdir (postgres/, jmeter-local-orchestrator/, …)
# read these with ${VAR:-default} fallbacks so they continue to work when run
# standalone (e.g. `docker compose -f postgres/docker-compose.yml up`). Operators
# can override any value by exporting it in their shell or copying this file
# to a personal .env.local and pointing Compose at it via `--env-file`.
#
# The values below are the local-dev defaults. They are NOT sensitive — the
# local stack has no auth and no real cloud credentials. The one exception is
# ANTHROPIC_API_KEY (optional, AI features only); leave it blank to keep AI
# analysis disabled. Cloud deployments source secrets from CloudFormation
# parameters / Secrets Manager / IRSA, never from this file.
#
# .env itself is git-ignored so a real key can never be committed.

# ── Compose profile ─────────────────────────────────────────────
# Plain `docker compose up` from the repo root activates this profile.
COMPOSE_PROFILES=default

# ── Project name ────────────────────────────────────────────────
# Compose derives the default network name from this: jmeter-cloud_default
# (Compose rejects camelCase project names — DNS-1123 lowercase-with-hyphens
# is the same exemption granted to K8s resource names). Every
# fragment under include: joins that network; cross-subsystem service
# discovery uses the Compose service names (postgres, metrics-consumer, …).
COMPOSE_PROJECT_NAME=jmeter-cloud

# ── Metrics transport ───────────────────────────────────────────
# DIRECT-METRICS + JSON-INGEST (2026-07-20): Kafka left the platform.
# Workers POST JSON WorkerMetricBatch envelopes straight to the metrics-consumer
# (`POST /api/v1/ingest`). The ingest URL is stamped onto each spawned
# worker by the global-orchestrator's PodProvisioner — override there via
# PODPROVISIONER_METRICS_INGEST_URL if the consumer moves.

# ── Worker containers ──────────────────────────────────────────
# Worker containers are spun up dynamically per application by the
# global-orchestrator's PodProvisioner — operators add workers from the
# Capacity UI (/capacity/{appName}). Per-pod env vars are not needed here.

# ── Provisioning posture (STATIC-FLEET) ────────────────────────
# Whether the control plane may create worker pods at all. Applies to BOTH
# orchestrators (global + k8s) — they are held feature-identical, see
# CHECKPOINTS/CHECKPOINTS-ORCHESTRATOR-PARITY.md.
#
# STATIC (DEFAULT since 2026-07-27) — workers are deployed and owned by the
#   operator, which is this platform's normal shape: private clouds where
#   on-demand provisioning is unavailable, or a namespace quota caps what may
#   be allocated. Spin / restart / container teardown answer
#   409 PROVISIONING_DISABLED, the reconciler + recycler are not wired, and
#   operators declare their workers per (application, data center).
#   Playbook: infra/deploy/k8s/staticFleet.md
#
# DYNAMIC — the control plane owns worker lifecycle (spin / restart / drain /
#   recycle) through a PodProvisioner.
#   ⚠ THIS IS WHAT LOCAL DEV WANTS. Under the STATIC default, the Capacity
#   tab is hidden and nothing will create workers for you on
#   `docker compose up` — you would have to deploy and declare them by hand.
#   Uncomment the line below for the classic spin-a-worker dev loop.
#
# GET /api/v1/platform/capabilities reports the resolved posture; the UI reads
# it to decide which surfaces to render.
#
# PROVISIONING_REGIONS is this deployment's region list — in STATIC mode these
#   are your data centers (e.g. na-east,na-west). Empty leaves the UI on its
#   own defaults. The API and schema keep calling the axis "region"; only the
#   UI label changes (CHECKPOINTS/CHECKPOINTS-STATIC-FLEET.md D1).
#PROVISIONING_MODE=DYNAMIC   # uncomment for the classic local-dev spin loop
#PROVISIONING_REGIONS=na-east,na-west

# ── Postgres ────────────────────────────────────────────────────
# Local-only credentials (throwaway). Cloud uses RDS-managed users via
# Secrets Manager / IRSA. Two databases — created on first container start by
# postgres/initdb/01_createDatabases.sql:
#   • jmetercloud_metrics    — written by jmeter-metrics-consumer,
#                              read by jmeter-global-orchestrator.
#   • jmetercloud_globalrun  — owned by jmeter-global-orchestrator.
POSTGRES_PORT=5432
POSTGRES_USER=jmetercloud
POSTGRES_PASSWORD=localdev
POSTGRES_DB=jmetercloud_metrics

# Per-app users (created by initdb, granted by Flyway):
#   metricsWriter            — INSERT on metrics.*. Used by metrics-consumer.
#   metricsReader            — SELECT on metrics.*. Used by global-orchestrator.
#   globalOrchestratorWriter — RW on globalOrchestrator.*. Used by global-orchestrator.
# All three share 'localdev' password locally; cloud uses IAM-DB auth.
POSTGRES_METRICS_WRITER_USER=metricsWriter
POSTGRES_METRICS_WRITER_PASSWORD=localdev
POSTGRES_METRICS_READER_USER=metricsReader
POSTGRES_METRICS_READER_PASSWORD=localdev
POSTGRES_GLOBALRUN_WRITER_USER=globalOrchestratorWriter
POSTGRES_GLOBALRUN_WRITER_PASSWORD=localdev

# ── Greenfield service ports ────────────────────────────────────
GLOBAL_ORCHESTRATOR_HTTP_PORT=8082
METRICS_CONSUMER_HTTP_PORT=8083
DOCUMENT_SERVICE_HTTP_PORT=8084
UI_HTTP_PORT=8086

# ── Observability ───────────────────────────────────────────────
# SLIMDOWN SL-D: Prometheus/Jaeger/postgres-exporter retired — Grafana
# (Application Performance dashboard on Postgres) is the only survivor.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Document service host mount ─────────────────────────────────
# Mounts ./.runtime/document-service into the document-service container
# so blobs are inspectable from the IDE.
DOCUMENT_SERVICE_HOST_ROOT=./.runtime/document-service

# ── Global orchestrator: AI analysis (optional) ─────────────────
# Server-side Claude proxy for AI run analysis. Leave blank to disable the
# AI features (the UI hides them when unset). To enable, paste an Anthropic
# API key here in your local .env (never in .env.example) or export it in
# your shell. Treat it as a secret — rotate if it is ever exposed.
ANTHROPIC_API_KEY=
