{
  "title": "Postgres",
  "uid": "postgres",
  "tags": ["jmetercloud", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datname",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(pg_stat_database_numbackends, datname)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "expr": "pg_up" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1,    "color": "green" }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_database_numbackends{datname=~\"$datname\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "DB size (jmetercloud_metrics)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        { "refId": "A", "expr": "pg_database_size_bytes{datname=\"jmetercloud_metrics\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "description": "Buffer-cache hit / (hit + read). Healthy >= 0.99 for hot tables.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_blks_hit{datname=~\"$datname\"}) / (sum(pg_stat_database_blks_hit{datname=~\"$datname\"}) + sum(pg_stat_database_blks_read{datname=~\"$datname\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.95, "color": "yellow" },
              { "value": 0.99, "color": "green" }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by database",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "maxDataPoints": 500,
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=~\"$datname\"}",
          "legendFormat": "{{datname}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transactions per second (commit + rollback)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "maxDataPoints": 500,
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} commits"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} rollbacks"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "tps" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tuples returned vs. fetched (read efficiency)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "maxDataPoints": 500,
      "description": "tup_returned = rows examined; tup_fetched = rows the client kept. Wide gap means a query is doing more work than its result implies (missing index, sequential scan).",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_tup_returned{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} returned"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_tup_fetched{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} fetched"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tuples inserted / updated / deleted (write rate)",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "maxDataPoints": 500,
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_tup_inserted{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} inserts"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_tup_updated{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} updates"
        },
        {
          "refId": "C",
          "expr": "rate(pg_stat_database_tup_deleted{datname=~\"$datname\"}[$__rate_interval])",
          "legendFormat": "{{datname}} deletes"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    }
  ]
}
