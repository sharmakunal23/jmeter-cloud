{
  "type": "record",
  "name": "WorkerMetricBatch",
  "namespace": "com.perf.orchestrator",
  "doc": "Per-second batch of aggregated metrics from a single JMeter worker pod. One envelope per (worker, windowSecond) pair carries N per-label entries — typically 1-500. Replaces the per-row WorkerMetric record (one Kafka record per label) with a single record covering the entire pod's window. Reduces wire-level redundancy of the 5 envelope-level fields (~96 B × N rows → 96 B once) and collapses the consumer's deserialise loop from N records to 1 per pod-window.",
  "fields": [
    {
      "name": "windowSecond",
      "type": "long",
      "default": 0,
      "doc": "Unix epoch second identifying the aggregation window."
    },
    {
      "name": "windowTimestamp",
      "type": "string",
      "default": "",
      "doc": "Human-readable window start in the format yyyy/MM/dd HH:mm:ss. Preserved from the raw JTL timestamp so consumers can display it without re-formatting epoch values."
    },
    {
      "name": "region",
      "type": "string",
      "default": "",
      "doc": "AWS region where this worker pod is running, e.g. us-east-1."
    },
    {
      "name": "workerId",
      "type": "string",
      "default": "",
      "doc": "Kubernetes pod name, e.g. jmeter-worker-4. Used to distinguish per-pod metrics and spot outlier workers."
    },
    {
      "name": "runId",
      "type": "string",
      "default": "",
      "doc": "Unique identifier for this test run, e.g. 20250413-east. Groups all windows from a single run for historical queries."
    },
    {
      "name": "joinedAtSecond",
      "type": "long",
      "default": 0,
      "doc": "MID-TEST-SCALING Phase C — number of seconds since run.startedAt at which this worker joined the run. 0 for original-fleet workers (joined at run start). > 0 for mid-test scale-up joiners (set by the global-orchestrator's POST /runs/{runId}/scaleUp). Lets the consumer + UI distinguish original-fleet from joiners and compute correct per-second fleet rollups (sum over members live at second X). Additive, BACKWARD-compatible — old consumers ignore the field; old envelopes default to 0."
    },
    {
      "name": "entries",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "WorkerMetricEntry",
          "namespace": "com.perf.orchestrator",
          "doc": "One per-label aggregate within a WorkerMetricBatch. The (worker, windowSecond) identity lives on the parent envelope; this entry carries only the per-label metrics. Consumer-side, an entry is projected onto the envelope's 5 metadata fields to reconstruct the per-row shape that lands in metrics.workerMetric.",
          "fields": [
            {
              "name": "label",
              "type": "string",
              "default": "",
              "doc": "JMeter sampler label, e.g. POST /api/payment. Primary metric dimension within an envelope."
            },
            {
              "name": "throughput",
              "type": "long",
              "default": 0,
              "doc": "Number of requests completed during this one-second window."
            },
            {
              "name": "errorCount",
              "type": "long",
              "default": 0,
              "doc": "Number of requests where JMeter success=false."
            },
            {
              "name": "errorRate",
              "type": "double",
              "default": 0.0,
              "doc": "errorCount / throughput as a value between 0.0 and 1.0. Zero when throughput is zero."
            },
            {
              "name": "avgRespTimeMs",
              "type": "double",
              "default": 0.0,
              "doc": "True mean response time in milliseconds across the window: sum of sample elapsed times / sample count. Distinct from p50 (median) — averages move with outliers, percentiles do not. Used by the historical Avg Response Time chart in the run-detail Metrics tab. Zero when throughput is zero."
            },
            {
              "name": "p50Ms",
              "type": "double",
              "default": 0.0,
              "doc": "50th percentile response time in milliseconds, computed via HDRHistogram."
            },
            {
              "name": "p90Ms",
              "type": "double",
              "default": 0.0,
              "doc": "90th percentile response time in milliseconds."
            },
            {
              "name": "p95Ms",
              "type": "double",
              "default": 0.0,
              "doc": "95th percentile response time in milliseconds."
            },
            {
              "name": "p99Ms",
              "type": "double",
              "default": 0.0,
              "doc": "99th percentile response time in milliseconds."
            },
            {
              "name": "minMs",
              "type": "double",
              "default": 0.0,
              "doc": "Fastest response time observed in this window."
            },
            {
              "name": "maxMs",
              "type": "double",
              "default": 0.0,
              "doc": "Slowest response time observed in this window. Clamped to HIGHEST_TRACKABLE_VALUE_MS when elapsed exceeds the histogram ceiling. Useful for detecting outliers that percentiles mask."
            },
            {
              "name": "rawMaxMs",
              "type": "long",
              "default": 0,
              "doc": "True maximum elapsed time in milliseconds, without HDRHistogram clamping. Equals maxMs for normal responses. Exceeds maxMs only when at least one request timed out beyond the 3,600,000ms histogram ceiling."
            },
            {
              "name": "bytesReceived",
              "type": "long",
              "default": 0,
              "doc": "Total bytes received from the server across all requests in this window."
            },
            {
              "name": "bytesSent",
              "type": "long",
              "default": 0,
              "doc": "Total bytes sent to the server across all requests in this window."
            },
            {
              "name": "statusCodes",
              "type": {"type": "map", "values": "long"},
              "default": {},
              "doc": "Frequency map of HTTP response codes observed in this window, e.g. {\"200\": 330, \"503\": 3}. Keys are the raw responseCode strings from the JTL, including non-HTTP codes."
            },
            {
              "name": "activeThreads",
              "type": "long",
              "default": 0,
              "doc": "Thread count from the last row processed in this window (allThreads column). Reflects JMeter concurrency level at the close of the window."
            }
          ]
        }
      },
      "default": [],
      "doc": "Per-label aggregates within this pod-window. Capped at MAX_ENTRIES_PER_ENVELOPE (default 500) producer-side — pathological test plans with more labels split into multiple envelopes carrying the same envelope-level metadata."
    }
  ]
}
