{
  "type": "record",
  "name": "WorkerMetric",
  "namespace": "com.perf.orchestrator",
  "doc": "Aggregated per-second performance metrics emitted by a single JMeter worker pod. One record per (worker, label, second) triple.",
  "fields": [
    {
      "name": "windowSecond",
      "type": "long",
      "default": 0,
      "doc": "Unix epoch second identifying the aggregation window."
    },
    {
      "name": "windowTimestamp",
      "type": "string",
      "default": "",
      "doc": "Human-readable window start in the format yyyy/MM/dd HH:mm:ss. Preserved from the raw JTL timestamp so consumers can display it without re-formatting epoch values."
    },
    {
      "name": "region",
      "type": "string",
      "default": "",
      "doc": "AWS region where this worker pod is running, e.g. us-east-1."
    },
    {
      "name": "workerId",
      "type": "string",
      "default": "",
      "doc": "Kubernetes pod name, e.g. jmeter-worker-4. Used to distinguish per-pod metrics and spot outlier workers."
    },
    {
      "name": "runId",
      "type": "string",
      "default": "",
      "doc": "Unique identifier for this test run, e.g. 20250413-east. Groups all windows from a single run for historical queries."
    },
    {
      "name": "label",
      "type": "string",
      "default": "",
      "doc": "JMeter sampler label, e.g. POST /api/payment. This is the primary metric dimension alongside workerId."
    },
    {
      "name": "throughput",
      "type": "long",
      "default": 0,
      "doc": "Number of requests completed during this one-second window."
    },
    {
      "name": "errorCount",
      "type": "long",
      "default": 0,
      "doc": "Number of requests where JMeter success=false."
    },
    {
      "name": "errorRate",
      "type": "double",
      "default": 0.0,
      "doc": "errorCount / throughput as a value between 0.0 and 1.0. Zero when throughput is zero."
    },
    {
      "name": "avgRespTimeMs",
      "type": "double",
      "default": 0.0,
      "doc": "True mean response time in milliseconds across the window: sum of sample elapsed times / sample count. Distinct from p50 (median) — averages move with outliers, percentiles do not. Used by the historical Avg Response Time chart in the run-detail Metrics tab. Zero when throughput is zero. Field added 2026-05-10 (HM-1A); BACKWARD-compatible default lets pre-existing readers continue without redeploy."
    },
    {
      "name": "p50Ms",
      "type": "double",
      "default": 0.0,
      "doc": "50th percentile response time in milliseconds, computed via HDRHistogram."
    },
    {
      "name": "p90Ms",
      "type": "double",
      "default": 0.0,
      "doc": "90th percentile response time in milliseconds."
    },
    {
      "name": "p95Ms",
      "type": "double",
      "default": 0.0,
      "doc": "95th percentile response time in milliseconds."
    },
    {
      "name": "p99Ms",
      "type": "double",
      "default": 0.0,
      "doc": "99th percentile response time in milliseconds."
    },
    {
      "name": "minMs",
      "type": "double",
      "default": 0.0,
      "doc": "Fastest response time observed in this window."
    },
    {
      "name": "maxMs",
      "type": "double",
      "default": 0.0,
      "doc": "Slowest response time observed in this window. Clamped to HIGHEST_TRACKABLE_VALUE_MS when elapsed exceeds the histogram ceiling. Useful for detecting outliers that percentiles mask."
    },
    {
      "name": "rawMaxMs",
      "type": "long",
      "default": 0,
      "doc": "True maximum elapsed time in milliseconds, without HDRHistogram clamping. Equals maxMs for normal responses. Exceeds maxMs only when at least one request timed out beyond the 3,600,000ms histogram ceiling. Use this field to detect extreme outliers that maxMs would mask."
    },
    {
      "name": "bytesReceived",
      "type": "long",
      "default": 0,
      "doc": "Total bytes received from the server across all requests in this window."
    },
    {
      "name": "bytesSent",
      "type": "long",
      "default": 0,
      "doc": "Total bytes sent to the server across all requests in this window."
    },
    {
      "name": "statusCodes",
      "type": {"type": "map", "values": "long"},
      "default": {},
      "doc": "Frequency map of HTTP response codes observed in this window, e.g. {\"200\": 330, \"503\": 3}. Keys are the raw responseCode strings from the JTL, including non-HTTP codes."
    },
    {
      "name": "activeThreads",
      "type": "long",
      "default": 0,
      "doc": "Thread count from the last row processed in this window (allThreads column). Reflects JMeter concurrency level at the close of the window."
    }
  ]
}

