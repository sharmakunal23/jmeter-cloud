<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.perf.globalorchestrator</groupId>
    <artifactId>jmeter-global-orchestrator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>jmeter-global-orchestrator</name>
    <description>
        Fan-out layer that drives many jmeter-local-orchestrators across
        regions/clusters. Owns run-state, coordinates fleet-wide test
        starts, and reads aggregated metrics from the Oracle rollups.
    </description>

    <properties>
        <!-- Boot's parent compiles with the release flag set to ${java.version} (17 by default),
             which silently overrides source/target. This is what makes it 21. -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- CACHE C-0 (2026-05-26) — shared cache layer. starter-cache pulls
             the Spring Cache abstraction (@EnableCaching, @Cacheable,
             @CacheEvict); starter-data-redis backs it with a RedisCacheManager
             so every global-orchestrator instance reads the SAME cache (the
             operator's "scalable at each layer + all instances share the
             cache" requirement). Provider is chosen by spring.cache.type:
             `redis` at runtime, `simple` in tests (ConcurrentMapCacheManager —
             no Redis needed; the terminal-vs-active gating is provider-agnostic).
             Both BOM-managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- ORACLE-MIGRATION (2026-08-28): both schemas live in Oracle.
             ojdbc11 is BOM-managed (oracle-database.version). -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- SLIMDOWN SL-E (2026-07-22): micrometer-registry-prometheus,
             spring-boot-starter-aop (@Observed was its only consumer, S-6
             grep-verified), micrometer-tracing-bridge-otel and
             opentelemetry-exporter-otlp removed — hosting infra provides
             observability. KEEP the JSON-logging deps below: logs are the
             debug/RCA surface. Don't reintroduce a metrics registry or
             tracer here. -->

        <!-- Structured JSON logging (KEPT by SLIMDOWN — the RCA surface).
             logstash-logback-encoder emits one JSON record per log line
             with `runId` / `actor` MDC keys promoted
             to top-level fields for log-search indexing. Version pinned
             explicitly: spring-boot-dependencies 3.5.x does NOT manage
             this artifact (only janino is BOM-managed). 7.4 matches the
             jmeter-local-orchestrator pin so all services emit identical
             JSON record shapes. janino powers the <if> conditional in
             logback-spring.xml that flips between JSON (default) and
             Spring Boot's pretty pattern when DEV_MODE_LOG=true (dev only). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>
        <!-- Springdoc OpenAPI — Swagger UI at /swagger-ui.html serving the
             hand-curated YAML bundled at static/openapi.yaml (see
             <resources> below). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.0</version>
        </dependency>
        <!-- AUTOMATION Phase E — JavaMailSender for the daily report emails.
             SMTP is the single backend: a MailHog container in dev compose,
             the deploy environment's relay in production. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ORACLE-MIGRATION OM-6 — the opt-in database contract tests
             (`mvn test -PdbTests`, JUnit tag `db`): Testcontainers boots
             Oracle Free, Flyway applies the real migrations from
             ../oracle/migrations, and the tests exercise the SQL the default
             loop never touches. All test scope; nothing here ships. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>oracle-free</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <!-- Bundle api/openapi.yaml into the JAR at static/openapi.yaml so
             Spring Boot's static-resource handler serves it at the URL
             /openapi.yaml (which Swagger UI is configured to load). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/api</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- The `db`-tagged contract tests need Docker and ~1 min for
                 Oracle Free to boot, so the default loop skips them; the
                 dbTests profile below runs ONLY them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>db</excludedGroups>
                </configuration>
            </plugin>
            <!-- Failsafe wires *IT.java behavior tests into `mvn verify`. -->
        </plugins>
    </build>

    <profiles>
        <!-- ORACLE-MIGRATION OM-6 — `mvn test -PdbTests` runs the `db`-tagged
             contract tests against a Testcontainers Oracle Free and nothing
             else. Requires Docker. -->
        <profile>
            <id>dbTests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>db</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- The -Pcloud profile (AWS SES + the src/main/java-cloud source
             root) was removed: SMTP is the one email backend; the deploy
             environment's relay is configured via the existing spring.mail
             env vars, and SES itself offers an SMTP endpoint. -->
        <!-- SECURITY S-14 — OWASP dependency CVE gate. Inert by default so the
             offline `mvn -o ...` flow is unaffected; activate online in CI:
               mvn -P securityScan verify
             First run downloads the NVD database (slow); speed it up with a key:
               mvn -P securityScan -DnvdApiKey=$NVD_API_KEY verify
             (request one at https://nvd.nist.gov/developers/request-an-api-key).
             Fails the build on any dependency with CVSS >= 7 (high/critical).
             NOTE: added offline — the scan itself has NOT been run in this
             environment; verify (and bump the plugin version to latest) on the
             first CI run. -->
        <profile>
            <id>securityScan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
