<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.perf.k8sorchestrator</groupId>
    <artifactId>jmeter-orchestrator-k8s</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>jmeter-orchestrator-k8s</name>
    <description>
        Fan-out layer that drives many jmeter-local-orchestrators across
        regions/clusters. Owns run-state, coordinates fleet-wide test
        starts, and reads aggregated metrics from the Postgres replica.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- CACHE C-0 (2026-05-26) — shared cache layer. starter-cache pulls
             the Spring Cache abstraction (@EnableCaching, @Cacheable,
             @CacheEvict); starter-data-redis backs it with a RedisCacheManager
             so every global-orchestrator instance reads the SAME cache (the
             operator's "scalable at each layer + all instances share the
             cache" requirement). Provider is chosen by spring.cache.type:
             `redis` at runtime, `simple` in tests (ConcurrentMapCacheManager —
             no Redis needed; the terminal-vs-active gating is provider-agnostic).
             Both BOM-managed by spring-boot-dependencies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- K8S-SLIMDOWN — no metrics/tracing stack in this service by
             design: the target deployment environment ships observability
             out of the box. Logs (below) + /actuator/health are the whole
             built-in surface. Deliberately absent: micrometer-registry-
             prometheus, micrometer-tracing-bridge-otel,
             opentelemetry-exporter-otlp, spring-boot-starter-aop. -->

        <!-- Structured JSON logging (KEPT by K8S-SLIMDOWN — "keep the logs").
             logstash-logback-encoder emits one JSON record per log line
             with `traceId` / `spanId` / `runId` / `actor` MDC keys promoted
             to top-level fields for log-search indexing. Version pinned
             explicitly: spring-boot-dependencies 3.5.x does NOT manage
             this artifact (only janino is BOM-managed). 7.4 matches the
             jmeter-local-orchestrator pin so all services emit identical
             JSON record shapes. janino powers the <if> conditional in
             logback-spring.xml that flips between JSON (default) and
             Spring Boot's pretty pattern when DEV_MODE_LOG=true (dev only). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>
        <!-- Springdoc OpenAPI — Swagger UI at /swagger-ui.html serving the
             hand-curated YAML bundled at static/openapi.yaml (see
             <resources> below). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
        <!-- K8S-ORCHESTRATOR Phase C — fabric8 drives worker-Pod lifecycle
             (create/delete/list by label) against the cluster API. Not
             managed by the Boot 3.5.14 BOM, so pinned explicitly (same
             pattern as the docker-java pins it replaces). -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>7.3.1</version>
        </dependency>
        <!-- Server-side mock (@EnableKubernetesMockClient) — provisioner
             unit tests run against an in-process API server, no cluster
             or daemon needed. -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <version>7.3.1</version>
            <scope>test</scope>
        </dependency>
        <!-- AUTOMATION Phase E — JavaMailSender for the daily report emails.
             SMTP is the single backend: a MailHog container in dev compose,
             the deploy environment's relay in production. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <!-- Bundle api/openapi.yaml into the JAR at static/openapi.yaml so
             Spring Boot's static-resource handler serves it at the URL
             /openapi.yaml (which Swagger UI is configured to load). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/api</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Failsafe wires *IT.java behavior tests into `mvn verify`. -->
        </plugins>
    </build>

    <profiles>
        <!-- K8S-SLIMDOWN C-A — the -Pcloud profile (AWS SES + the
             src/main/java-cloud source root) was removed: SMTP is the one
             email backend; the deploy environment's relay is configured via
             the existing spring.mail env vars. -->
        <!-- SECURITY S-14 — OWASP dependency CVE gate. Inert by default so the
             offline `mvn -o ...` flow is unaffected; activate online in CI:
               mvn -P securityScan verify
             First run downloads the NVD database (slow); speed it up with a key:
               mvn -P securityScan -DnvdApiKey=$NVD_API_KEY verify
             (request one at https://nvd.nist.gov/developers/request-an-api-key).
             Fails the build on any dependency with CVSS >= 7 (high/critical).
             NOTE: added offline — the scan itself has NOT been run in this
             environment; verify (and bump the plugin version to latest) on the
             first CI run. -->
        <profile>
            <id>securityScan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>9.2.0</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
