<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.perf.documentservice</groupId>
    <artifactId>document-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>document-service</name>
    <description>
        HTTP gateway that abstracts blob storage for the jmeter-cloud platform.
        Backends: LocalFsBlobStore (local dev), S3BlobStore (cloud — under
        -Pcloud profile). Step 7 ships the skeleton with stubbed endpoints;
        full implementation tracks alongside the orchestrator's storage
        backend follow-up.
    </description>

    <properties>
        <!-- Boot's parent compiles with the release flag set to ${java.version} (17 by default),
             which silently overrides source/target. This is what makes it 21. -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- SLIMDOWN (2026-07-21) — no metrics/tracing stack in this service:
             the hosting infra provides observability out of the box.
             Deliberately absent: micrometer-registry-prometheus,
             micrometer-tracing-bridge-otel, opentelemetry-exporter-otlp.
             Logs (below) + /actuator/{health,info} are the whole built-in
             surface — do not reintroduce a registry or tracer. -->

        <!-- OBSERVABILITY Phase A — structured JSON logging.
             logstash-logback-encoder version pinned explicitly:
             spring-boot-dependencies 3.5.x does NOT manage this artifact
             (only janino is BOM-managed). 7.4 matches the pin in the
             jmeter-local-orchestrator + jmeter-global-orchestrator poms
             so all services emit identical JSON record shapes. janino
             powers the <if> conditional in logback-spring.xml that flips
             between JSON (default) and Spring Boot's pretty pattern when
             DEV_MODE_LOG=true (interactive dev only). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>
        <!-- Springdoc OpenAPI — Swagger UI at /swagger-ui.html serving the
             hand-curated YAML bundled at static/openapi.yaml (see
             <resources> below). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <!-- Bundle api/openapi.yaml into the JAR at static/openapi.yaml so
             Spring Boot's static-resource handler serves it at the URL
             /openapi.yaml (which Swagger UI is configured to load). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/api</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Failsafe wires *IT.java behavior tests into `mvn verify`. -->
        </plugins>
    </build>

    <profiles>
        <!-- Cloud-only profile: enables the S3 blob-store backend. The
             default fat JAR stays AWS-SDK-free so air-gapped local dev
             doesn't carry an unused 12+ MB SDK. Mirrors the orchestrator's
             -Pstorage-s3 pattern: source root src/main/javaCloud/ is
             added by build-helper-maven-plugin only when this profile
             is active. -->
        <profile>
            <id>cloud</id>
            <dependencies>
                <dependency>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>s3</artifactId>
                    <version>2.54.5</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>add-cloud-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/javaCloud</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-cloud-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/javaCloud</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- SECURITY S-14 — OWASP dependency CVE gate. Inert by default so the
             offline `mvn -o ...` flow is unaffected; activate online in CI:
               mvn -P securityScan verify
             First run downloads the NVD database (slow); speed it up with a key:
               mvn -P securityScan -DnvdApiKey=$NVD_API_KEY verify
             (request one at https://nvd.nist.gov/developers/request-an-api-key).
             Fails the build on any dependency with CVSS >= 7 (high/critical).
             NOTE: added offline — the scan itself has NOT been run in this
             environment; verify (and bump the plugin version to latest) on the
             first CI run. -->
        <profile>
            <id>securityScan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
