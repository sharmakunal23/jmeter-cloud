<?xml version="1.0" encoding="UTF-8"?>
<!--
  Structured JSON logging — one record per line on stdout, which is the whole
  observability surface this service ships (SLIMDOWN, 2026-07-22). Set
  DEV_MODE_LOG=true for Spring Boot's plaintext during interactive dev; the
  janino-powered <if> below swaps the root appender at config-load time.

  MdcEnrichmentFilter and AccessLogFilter populate the MDC keys listed below at
  request entry, and they surface as top-level JSON fields when present.
  traceId/spanId are inert leftovers — nothing has populated them since tracing
  was removed.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName"
                    source="spring.application.name"
                    defaultValue="document-service"/>

    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <includeMdcKeyName>runId</includeMdcKeyName>
            <includeMdcKeyName>applicationId</includeMdcKeyName>
            <includeMdcKeyName>workerId</includeMdcKeyName>
            <includeMdcKeyName>actor</includeMdcKeyName>
            <includeMdcKeyName>errorContext</includeMdcKeyName>
            <includeMdcKeyName>blobId</includeMdcKeyName>
            <!-- Access-log keys, set by AccessLogFilter. -->
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>path</includeMdcKeyName>
            <includeMdcKeyName>status</includeMdcKeyName>
            <includeMdcKeyName>latencyMs</includeMdcKeyName>
            <includeMdcKeyName>clientIp</includeMdcKeyName>
            <includeMdcKeyName>userAgent</includeMdcKeyName>
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <if condition='"true".equals(System.getenv("DEV_MODE_LOG"))'>
        <then>
            <root level="INFO"><appender-ref ref="CONSOLE_TEXT"/></root>
        </then>
        <else>
            <root level="INFO"><appender-ref ref="CONSOLE_JSON"/></root>
        </else>
    </if>

</configuration>
