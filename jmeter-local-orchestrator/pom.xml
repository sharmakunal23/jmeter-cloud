<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.perf.orchestrator</groupId>
    <artifactId>jmeter-local-orchestrator</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>jmeter-local-orchestrator</name>
    <description>
        HTTP-driven orchestrator that runs alongside one JMeter worker per
        Kubernetes pod or EC2 instance. Accepts test artifacts via REST,
        launches JMeter as a child process, tails the JTL output, aggregates
        1-second tumbling windows per label (HDRHistogram percentiles), and
        POSTs WorkerMetricBatch JSON envelopes directly to the
        metrics-consumer's /api/v1/ingest endpoint.
    </description>

    <properties>
        <!-- Build -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Reproducible builds: fixed timestamp => identical JAR bytes for identical source.
             Override in CI with -Dproject.build.outputTimestamp=<git-commit-epoch>. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <!-- Shade Main-Class. -->
        <app.main.class>com.perf.orchestrator.OrchestratorMain</app.main.class>

        <!-- Enforce minimums -->
        <enforcer.maven.version>3.8.0</enforcer.maven.version>
        <enforcer.java.version>21</enforcer.java.version>

        <!-- Runtime dependency versions. The metrics path carries no
             serialization dependency: the ingest body is JSON, handled by the
             Jackson that spring-boot-starter-web already brings. -->
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <!-- slf4j + logback aligned with Spring Boot 3.5.16's BOM-managed
             versions. Bumping past 1.5.3 is mandatory: Spring Boot's
             LoggingApplicationListener calls LoggerContext.initCollisionMaps()
             which only exists in Logback 1.5.7+, so the older version trips
             NoSuchMethodError as soon as a SpringApplication boots. The bump
             also clears CVE-2024-12798 (Logback JaninoEventEvaluator). -->
        <slf4j.version>2.0.18</slf4j.version>
        <logback.version>1.5.34</logback.version>
        <logstash.encoder.version>8.1</logstash.encoder.version>
        <!-- janino: powers the <if> conditional in logback-spring.xml that
             flips between JSON and Spring Boot's pretty pattern when
             DEV_MODE_LOG=true. ~770 KB; within the < 60 MB JAR budget. -->
        <janino.version>3.1.12</janino.version>
        <aws.sdk.version>2.54.5</aws.sdk.version>

        <!-- Spring Boot 3.5.x — current maintained 3.x line (3.4.x is EOL).
             Boot 4.x is GA but is a coupled major migration (Spring
             Framework 7 + Jackson 3 + springdoc 3 + Logback 1.6); staying
             on 3.5.x is a deliberate choice, not drift.
             Imported as a BOM (NOT as a parent) so its versions of JUnit,
             Mockito, AssertJ, Jackson, Logback, SLF4J, Tomcat, etc. are
             managed centrally without forcing the orchestrator to inherit
             Spring Boot's plugin defaults.
             (The jetty-bom 11.0.24 import that previously sat above this
             one was removed in Step 4.5 along with Javalin — Spring Boot
             Tomcat owns the embedded server now.) -->
        <spring.boot.version>3.5.16</spring.boot.version>

        <junit.version>5.12.2</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.17.0</mockito.version>
        <awaitility.version>4.2.2</awaitility.version>

        <!-- Plugin versions -->
        <compiler.plugin.version>3.15.0</compiler.plugin.version>
        <surefire.plugin.version>3.5.6</surefire.plugin.version>
        <shade.plugin.version>3.6.2</shade.plugin.version>
        <enforcer.plugin.version>3.6.3</enforcer.plugin.version>
        <jacoco.plugin.version>0.8.15</jacoco.plugin.version>
        <build.helper.version>3.6.1</build.helper.version>
    </properties>

    <!-- Centralized version management. -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM declared FIRST so its tested versions of
                 JUnit (5.12.2) / Mockito (5.17) / AssertJ (3.27.7) / Jackson /
                 Logback / SLF4J win across the dep tree. Confluent 7.6.0's
                 parent (imported below) ships an older JUnit (5.8.2) that
                 lacks ExtensionContext.getExecutableInvoker() — pulling it
                 in trips NoSuchMethodError the moment a @WebMvcTest tries
                 to boot. Maven's first-declared-wins for BOM imports keeps
                 Spring Boot's versions authoritative.

                 (The jetty-bom 11.0.24 import that previously sat at the
                 top of this list was removed in Step 4.5 along with Javalin
                 — Spring Boot Tomcat owns the embedded server now and has
                 zero Jetty artifacts on the classpath.) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Force slf4j-api 2.0.x across the whole tree — Logback 1.5.x
                 requires it; a transitive 1.7.x winning nearest-wins would
                 leave Logback silently unbound (NOP logging) at runtime. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- AWS SDK v2 (only included via -Pstorage-s3) pulls commons-codec
                 twice — 1.11 via Apache HttpClient and 1.15 directly from the
                 SDK's apache-client. Pin a single recent version so dependency
                 convergence passes when the profile is active. Harmless on
                 the default profile because nothing references it. -->
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.22.1</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- =========================================================
             RUNTIME DEPENDENCIES
             ========================================================= -->

        <!-- HDRHistogram — streaming percentiles in SecondBucket. -->
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
        </dependency>

        <!-- springdoc-openapi — serves Swagger UI at /swagger-ui.html and
             the OpenAPI JSON at /v3/api-docs (auto-generated from the
             @RestController annotations). The hand-curated YAML lives at
             api/openapi.yaml and is bundled into the JAR via the
             <resource> mapping in <build>; configure
             springdoc.swagger-ui.url=/openapi.yaml in application.yml so
             the UI renders the curated spec rather than the auto one. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.0</version>
        </dependency>

        <!-- =========================================================
             SPRING BOOT — embedded Tomcat + DispatcherServlet + actuator

             Owns the entire HTTP surface as of Step 4.4h: 6
             @RestControllers + /actuator/{health,info,prometheus} on
             HTTP_PORT. The Javalin / Jetty 11 dependencies that previously
             served HTTP_PORT were removed in Step 4.5.

             Excludes:
             - spring-boot-starter-logging: we manage logback + slf4j
               + jul-to-slf4j explicitly above. Keeping ours as the
               sole logging path avoids classpath duplication and
               keeps version control in our hands.
             ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- SLIMDOWN (2026-07-21) — no metrics/tracing stack in this service:
             the hosting infra provides observability out of the box.
             Deliberately absent: micrometer-registry-prometheus,
             micrometer-tracing-bridge-otel, opentelemetry-exporter-otlp,
             spring-boot-starter-aop (sole consumer was the @Observed aspect).
             Logs + /actuator/{health,info} + the app-level REST surface
             (/api/v1/metrics/*, /api/v1/logs — CurrentRun/LongAdder-backed,
             never Micrometer) are the whole observability surface.
             Do not reintroduce a metrics registry or a tracer. -->

        <!-- =========================================================
             LOGGING
             SLF4J API + Logback binding. Without a binding, application
             logs are silently dropped (NOP logger).
             Logstash encoder gives structured JSON logs for Kubernetes
             log aggregation (Fluent Bit, Vector, CloudWatch).
             ========================================================= -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>
        <!-- OBSERVABILITY Phase A — janino enables the <if> conditional
             in logback-spring.xml. Without it, logback parses the file
             but silently ignores the conditional and falls through to
             the default appender — which would defeat the DEV_MODE_LOG
             knob. -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
            <version>${janino.version}</version>
        </dependency>

        <!-- Bridge java.util.logging (used by the buffer/dispatcher classes
             and a few libraries) into SLF4J so all logs go through one
             pipeline. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- =========================================================
             TEST DEPENDENCIES
             ========================================================= -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot test scaffolding (Step 4.1 — coexisting with Javalin
             tests). Provides @SpringBootTest, MockMvc, @MockBean, ApplicationContextRunner
             so the upcoming controller migration can use Spring's slice-test
             support. Excludes the logging starter to align with the runtime
             dep above. JUnit 5 / Mockito / AssertJ / Awaitility transitives
             converge with our explicit declarations via Spring Boot's BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <!-- Bundle api/openapi.yaml into the JAR at static/openapi.yaml so
             Spring Boot's static-resource handler serves it at the URL
             /openapi.yaml (which Swagger UI is configured to load). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/api</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- =========================================================
                 ENFORCER: fail fast on bad environments and dependency
                 conflicts. Critical for performance-sensitive code where
                 silent version drift causes subtle bugs.
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${enforcer.maven.version}</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>${enforcer.java.version}</version>
                                </requireJavaVersion>
                                <!-- Fail if the same artifact resolves to different versions
                                     across the dep tree. Catches classpath mismatches before
                                     they explode at runtime. -->
                                <dependencyConvergence/>
                                <!-- Block snapshot deps in release builds. -->
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- =========================================================
                 COMPILER
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <!-- -parameters preserves method parameter names in bytecode,
                         useful for reflection-heavy libraries and better debugging. -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- =========================================================
                 UNIT TESTS (surefire): *Test.java, fast, no external deps
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} -Xmx512m -XX:+ExitOnOutOfMemoryError</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- Forks scale with cores and are reused: a JVM per test
                         class isolated leaked state, but cost ~40 s per run. -->
                    <forkCount>1C</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>


            <!-- =========================================================
                 COVERAGE
                 ========================================================= -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- =========================================================
                 SHADE: fat JAR for the orchestrator container image.
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <!-- Do NOT set <minimizeJar>true</minimizeJar>: it breaks
                                 SLF4J binding discovery and Spring's reflective
                                 auto-configuration loading. Minimization in this
                                 project costs more bugs than it saves megabytes. -->

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${app.main.class}</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <!-- Merge META-INF/services/* from all jars. Critical for
                                     SLF4J provider lookup. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge Spring Boot 3.x auto-configuration imports. Without
                                     this, the shaded JAR carries only the LAST jar's imports
                                     file (last-jar-wins) and dozens of auto-config classes
                                     fail to register at boot — symptom: NoSuchBeanDefinitionException
                                     on MeterRegistry / etc. when the orchestrator starts
                                     in a container. spring-boot-actuator +
                                     micrometer-registry-prometheus ship their own
                                     imports lines. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.actuate.autoconfigure.web.ManagementContextConfiguration.imports</resource>
                                </transformer>
                                <!-- Spring Boot 2.x → 3.x transition: a few libraries still
                                     ship spring.factories. Merge it too. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                                <!-- Prevent duplicate LICENSE/NOTICE warnings in the merged JAR. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature files must be stripped or the merged
                                             JAR fails SecurityException on startup. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- module-info duplication breaks the shaded JAR when
                                             multiple dependencies ship Jigsaw descriptors. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Maven metadata bloat. -->
                                        <exclude>META-INF/maven/**</exclude>
                                        <!-- Cut source jars accidentally included. -->
                                        <exclude>**/*.java</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- =========================================================
         PROFILES
         ========================================================= -->
    <profiles>
        <!-- Skip integration tests by default in local dev; enable in CI. -->
        <profile>
            <id>skip-it</id>
            <activation>
                <property>
                    <name>skipITs</name>
                </property>
            </activation>
            <properties>
                <skipITs>true</skipITs>
            </properties>
        </profile>

        <!-- AWS S3 artifact-source backend (added in MIGRATION step 10).

             S3 is intentionally an *artifact source only* — RESULT_SINK=S3
             is rejected at config-load time. Source for S3ArtifactSource
             lives in src/main/java-storage-s3/ and is compiled only when
             this profile is active. The default fat JAR remains S3-free
             so air-gapped clusters and non-AWS deployments don't carry
             an unused 12+ MB SDK.

             Authentication is via AWS's default credentials chain
             (IAM instance profile on EC2; IRSA in EKS); credentials are
             never read from the request body. -->
        <profile>
            <id>storage-s3</id>
            <dependencies>
                <dependency>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>s3</artifactId>
                    <version>${aws.sdk.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-storage-s3-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/java-storage-s3</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-storage-s3-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java-storage-s3</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Document Service result-sink backend (added in MIGRATION step 9).

             Source for DocumentServiceResultSink lives in
             src/main/java-storage-docservice/ and is added to the build
             only when this profile is active. The default fat JAR is
             unaffected — important because the orchestrator runs in
             air-gapped clusters where the doc service isn't reachable.

             Implementation uses java.net.http.HttpClient — zero new
             direct dependencies. -->
        <profile>
            <id>storage-docservice</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-storage-docservice-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/java-storage-docservice</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-storage-docservice-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java-storage-docservice</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- SECURITY S-14 — OWASP dependency CVE gate. Inert by default so the
             offline `mvn -o ...` flow is unaffected; activate online in CI:
               mvn -P securityScan verify
             First run downloads the NVD database (slow); speed it up with a key:
               mvn -P securityScan -DnvdApiKey=$NVD_API_KEY verify
             (request one at https://nvd.nist.gov/developers/request-an-api-key).
             Fails the build on any dependency with CVSS >= 7 (high/critical).
             NOTE: added offline — the scan itself has NOT been run in this
             environment; verify (and bump the plugin version to latest) on the
             first CI run. -->
        <profile>
            <id>securityScan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.2.2</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
