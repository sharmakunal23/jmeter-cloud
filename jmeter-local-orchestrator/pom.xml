<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.perf.orchestrator</groupId>
    <artifactId>jmeter-local-orchestrator</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>jmeter-local-orchestrator</name>
    <description>
        HTTP-driven orchestrator that runs alongside one JMeter worker per
        Kubernetes pod or EC2 instance. Accepts test artifacts via REST,
        launches JMeter as a child process, tails the JTL output, aggregates
        1-second tumbling windows per label (HDRHistogram percentiles), and
        publishes WorkerMetric Avro records to Kafka.
    </description>

    <properties>
        <!-- Build -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Reproducible builds: fixed timestamp => identical JAR bytes for identical source.
             Override in CI with -Dproject.build.outputTimestamp=<git-commit-epoch>. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <!-- Shade Main-Class. -->
        <app.main.class>com.perf.orchestrator.OrchestratorMain</app.main.class>

        <!-- Enforce minimums -->
        <enforcer.maven.version>3.8.0</enforcer.maven.version>
        <enforcer.java.version>21</enforcer.java.version>

        <!-- Runtime dependency versions.

             kafka-clients 3.9.2 is the head of Apache's 3.x patch line as of
             this audit. Bumped from 3.6.1 to clear CVEs accumulated across
             the 3.6 / 3.7 / 3.8 series (notably the SCRAM-auth class —
             relevant once cloud profile enables MSK SASL). Apache Kafka's
             client wire protocol and the Serializer<T> SPI that Confluent
             7.6.0's kafka-avro-serializer compiles against have been stable
             since Kafka 0.10, so the Apache 3.6 → 3.9 bump does not break
             the Confluent stack.

             avro 1.11.4 clears CVE-2024-47561 (Schema parsing RCE in the
             Java SDK). Reachable for us via SchemaRegistryClient at boot;
             1.11.4 is a patch release, API-compatible with 1.11.3.

             confluent stays at 7.6.0 — bumping to 8.x is a major-version
             jump with artifact renames; no specific CVE forces it. Its
             transitive kafka-clients (7.6.0-ccs) is excluded in the
             dependency declaration below; we use Apache upstream. -->
        <kafka.version>3.9.2</kafka.version>
        <confluent.version>7.6.0</confluent.version>
        <avro.version>1.11.4</avro.version>
        <!-- snappy-java: explicit pin (managed below, not a runtime dep
             we declare directly). 1.1.10.7 is the latest patch release. -->
        <snappy.java.version>1.1.10.7</snappy.java.version>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <!-- slf4j + logback aligned with Spring Boot 3.5.14's BOM-managed
             versions. Bumping past 1.5.3 is mandatory: Spring Boot's
             LoggingApplicationListener calls LoggerContext.initCollisionMaps()
             which only exists in Logback 1.5.7+, so the older version trips
             NoSuchMethodError as soon as a SpringApplication boots. The bump
             also clears CVE-2024-12798 (Logback JaninoEventEvaluator). -->
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.32</logback.version>
        <logstash.encoder.version>7.4</logstash.encoder.version>
        <!-- janino: powers the <if> conditional in logback-spring.xml that
             flips between JSON and Spring Boot's pretty pattern when
             DEV_MODE_LOG=true. ~770 KB; within the < 60 MB JAR budget. -->
        <janino.version>3.1.12</janino.version>
        <aws.sdk.version>2.25.50</aws.sdk.version>

        <!-- Spring Boot 3.5.x — current maintained 3.x line (3.4.x is EOL,
             4.0 still RC at audit time).
             Imported as a BOM (NOT as a parent) so its versions of JUnit,
             Mockito, AssertJ, Jackson, Logback, SLF4J, Tomcat, etc. are
             managed centrally without forcing the orchestrator to inherit
             Spring Boot's plugin defaults.
             (The jetty-bom 11.0.24 import that previously sat above this
             one was removed in Step 4.5 along with Javalin — Spring Boot
             Tomcat owns the embedded server now.) -->
        <spring.boot.version>3.5.14</spring.boot.version>

        <!-- Test dependency versions — aligned with Spring Boot 3.5.14's BOM
             so Spring's test scaffolding (compiled against JUnit 5.12 /
             Mockito 5.17 / AssertJ 3.27 / Awaitility 4.2.2) does NOT trip
             NoSuchMethodError at runtime. AssertJ 3.27.7 also clears
             CVE-2026-24400 (XXE in isXmlEqualTo).
             Testcontainers is BOM-managed by spring-boot-dependencies
             (1.21.4), so no property override here — letting the BOM win
             keeps testcontainers, junit-jupiter and slf4j on a tested
             matrix. -->
        <junit.version>5.12.2</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <mockito.version>5.17.0</mockito.version>
        <awaitility.version>4.2.2</awaitility.version>

        <!-- Plugin versions -->
        <compiler.plugin.version>3.12.1</compiler.plugin.version>
        <surefire.plugin.version>3.2.5</surefire.plugin.version>
        <failsafe.plugin.version>3.2.5</failsafe.plugin.version>
        <shade.plugin.version>3.5.2</shade.plugin.version>
        <enforcer.plugin.version>3.4.1</enforcer.plugin.version>
        <jacoco.plugin.version>0.8.11</jacoco.plugin.version>
        <build.helper.version>3.5.0</build.helper.version>
    </properties>

    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <!--
        Centralized version management. Using Confluent's BOM keeps
        kafka-avro-serializer, kafka-schema-registry-client, kafka-schema-rules,
        and kafka-schema-serializer pinned to a single, mutually-compatible set.
        This prevents the NoClassDefFoundError: RuleException class of bugs
        caused by mixed Confluent versions on the classpath.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM declared FIRST so its tested versions of
                 JUnit (5.12.2) / Mockito (5.17) / AssertJ (3.27.7) / Jackson /
                 Logback / SLF4J win across the dep tree. Confluent 7.6.0's
                 parent (imported below) ships an older JUnit (5.8.2) that
                 lacks ExtensionContext.getExecutableInvoker() — pulling it
                 in trips NoSuchMethodError the moment a @WebMvcTest tries
                 to boot. Maven's first-declared-wins for BOM imports keeps
                 Spring Boot's versions authoritative.

                 (The jetty-bom 11.0.24 import that previously sat at the
                 top of this list was removed in Step 4.5 along with Javalin
                 — Spring Boot Tomcat owns the embedded server now and has
                 zero Jetty artifacts on the classpath.) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-parent</artifactId>
                <version>${confluent.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- testcontainers-bom intentionally not imported here.
                 spring-boot-dependencies (declared first) already manages
                 testcontainers artifacts on a tested matrix (1.21.4 at
                 Spring Boot 3.5.14). Importing testcontainers-bom would
                 be shadowed by Spring Boot's first-declared-wins anyway. -->

            <!-- snappy-java explicit pin. Kafka 3.9.x ships 1.1.10.6
                 transitively; pinning 1.1.10.7 here keeps us on the
                 latest patch release independent of kafka-clients
                 future bumps. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy.java.version}</version>
            </dependency>

            <!-- Force slf4j-api 2.0.x across the whole tree.
                 Kafka 3.6.1 and Avro 1.11.3 bring slf4j-api 1.7.36 transitively,
                 but Logback 1.5.x requires slf4j-api 2.0.x. Without this, Maven's
                 nearest-wins rule picks 1.7.36 and Logback silently fails to bind,
                 leaving you with NOP logging at runtime. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Force the Apache upstream kafka-clients everywhere. The Confluent
                 schema registry client transitively pulls kafka-clients:7.6.0-ccs
                 (Confluent's rebuild). Mixing -ccs and upstream on one classpath
                 is indeterminate. Pin to Apache 3.9.2 — the orchestrator is a
                 pure producer (no Confluent-specific patches needed) and 3.9.x
                 carries the accumulated CVE fixes from the 3.6 → 3.9 line. -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>

            <!-- AWS SDK v2 (only included via -Pstorage-s3) pulls commons-codec
                 twice — 1.11 via Apache HttpClient and 1.15 directly from the
                 SDK's apache-client. Pin a single recent version so dependency
                 convergence passes when the profile is active. Harmless on
                 the default profile because nothing references it. -->
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.16.1</version>
            </dependency>

            <!-- Avro 1.11.3 brings commons-compress 1.21; Confluent's
                 schema-registry chain pulls 1.22; Spring Boot's BOM may
                 manage a different 1.x. Pin to a single recent CVE-clean
                 version so dependencyConvergence passes across the whole
                 tree. (Discovered as a hard-stop during the prior Spring
                 Boot migration attempt.) -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.26.2</version>
            </dependency>

            <!-- Avro 1.11.4 — clears CVE-2024-47561 (Schema parsing RCE
                 in the Avro Java SDK). Confluent 7.6.0's kafka-avro-serializer
                 + kafka-schema-registry-client transitively pull 1.11.3, so
                 without this pin dependencyConvergence fails. 1.11.4 is a
                 patch release on the 1.11 line; API-compatible with the
                 generated WorkerMetric Avro class. -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- =========================================================
             RUNTIME DEPENDENCIES
             ========================================================= -->

        <!-- Kafka producer client.
             Version pinned explicitly; Confluent BOM targets a compatible
             kafka-clients but we want to control the exact client version
             for performance tuning and CVE tracking. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
            <exclusions>
                <!-- Pulls slf4j-api 1.7.36 which is incompatible with Logback 1.5.x.
                     Our dependencyManagement section forces 2.0.12 globally, but
                     excluding here keeps the dep tree clean and explicit. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <!-- zstd-jni ships ~13 MB of platform-specific native libs
                     (linux x86_64/aarch64, darwin x86_64/aarch64, win, freebsd)
                     for the Zstandard compression codec. The orchestrator's
                     Kafka producer never sets compression.type=zstd; trimming
                     this saves the equivalent of ~50% of the fat JAR. If a
                     future config switches compression to zstd, drop this
                     exclusion and the JAR grows back. -->
                <exclusion>
                    <groupId>com.github.luben</groupId>
                    <artifactId>zstd-jni</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Avro runtime — used by generated WorkerMetric class. -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>${avro.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Confluent Avro serializer. Pulls kafka-schema-registry-client,
             kafka-schema-serializer, and kafka-schema-rules transitively
             (versions managed by the BOM above).

             IMPORTANT: Do NOT also declare kafka-schema-registry-client
             with a different scope — that overrides the transitive compile
             scope and causes RuleException NoClassDefFoundError at runtime. -->
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
            <exclusions>
                <!-- We manage slf4j-api ourselves. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <!-- The schema registry client transitively pulls
                     kafka-clients:7.6.0-ccs (Confluent's rebuild of Apache 3.6.x).
                     We want only the upstream Apache 3.6.1 on the classpath. -->
                <exclusion>
                    <groupId>org.apache.kafka</groupId>
                    <artifactId>kafka-clients</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- HDRHistogram — streaming percentiles in SecondBucket. -->
        <dependency>
            <groupId>org.hdrhistogram</groupId>
            <artifactId>HdrHistogram</artifactId>
            <version>${hdrhistogram.version}</version>
        </dependency>

        <!-- springdoc-openapi — serves Swagger UI at /swagger-ui.html and
             the OpenAPI JSON at /v3/api-docs (auto-generated from the
             @RestController annotations). The hand-curated YAML lives at
             api/openapi.yaml and is bundled into the JAR via the
             <resource> mapping in <build>; configure
             springdoc.swagger-ui.url=/openapi.yaml in application.yml so
             the UI renders the curated spec rather than the auto one. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>

        <!-- Spring Kafka — KafkaTemplate wraps the producer so its
             metrics are auto-exposed at /actuator/metrics/kafka.producer.*
             (Micrometer Kafka binder is wired by spring-boot-actuator
             when spring-kafka is on the classpath). Version is BOM-managed
             by spring-boot-dependencies (3.3.x line for Spring Boot 3.5.x).
             We exclude spring-kafka's transitive kafka-clients so our
             pinned Apache 3.9.2 wins. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.kafka</groupId>
                    <artifactId>kafka-clients</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- =========================================================
             SPRING BOOT — embedded Tomcat + DispatcherServlet + actuator

             Owns the entire HTTP surface as of Step 4.4h: 6
             @RestControllers + /actuator/{health,info,prometheus} on
             HTTP_PORT. The Javalin / Jetty 11 dependencies that previously
             served HTTP_PORT were removed in Step 4.5.

             Excludes:
             - spring-boot-starter-logging: we manage logback + slf4j
               + jul-to-slf4j explicitly above. Keeping ours as the
               sole logging path avoids classpath duplication and
               keeps version control in our hands.
             ========================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Wires /actuator/prometheus so Prometheus scrapers can hit
             the orchestrator without the bespoke PrometheusExporter
             that the legacy Javalin /api/v1/metrics endpoint uses.
             That custom exporter is deleted in 4.4g (ObservabilityController
             migration). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- =========================================================
             LOGGING
             SLF4J API + Logback binding. Without a binding, all Kafka,
             Avro, and application logs are silently dropped (NOP logger).
             Logstash encoder gives structured JSON logs for Kubernetes
             log aggregation (Fluent Bit, Vector, CloudWatch).
             ========================================================= -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>
        <!-- OBSERVABILITY Phase A — janino enables the <if> conditional
             in logback-spring.xml. Without it, logback parses the file
             but silently ignores the conditional and falls through to
             the default appender — which would defeat the DEV_MODE_LOG
             knob. -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
            <version>${janino.version}</version>
        </dependency>

        <!-- OBSERVABILITY Phase D — AOP for @Observed annotation-driven spans.
             ObservedAspect (registered in ObservationConfig) instruments
             TestRunManager.start/drain/abort with per-action spans. Spring
             AOP proxies; ~1 MB added to the fat JAR. Local-orch budget
             (60 MB) stays safe at ~59 MB after this. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- OBSERVABILITY Phase B — distributed tracing.
             micrometer-tracing-bridge-otel wires Spring Boot's tracer
             onto the OpenTelemetry SDK; opentelemetry-exporter-otlp
             ships spans to Jaeger over OTLP HTTP (default OkHttp sender;
             no netty/gRPC). Versions BOM-managed by spring-boot-dependencies
             — no explicit pin needed since the BOM is imported at the
             top of dependencyManagement above. ~7 MB total per JAR;
             local-orch JAR budget (60 MB) stays safe at ~58 MB. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Bridge java.util.logging (used by Kafka internals in a few places)
             into SLF4J so all logs go through one pipeline. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- =========================================================
             TEST DEPENDENCIES
             ========================================================= -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers for integration tests against real Kafka.
             Used only in *IT.java tests run by failsafe. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot test scaffolding (Step 4.1 — coexisting with Javalin
             tests). Provides @SpringBootTest, MockMvc, @MockBean, ApplicationContextRunner
             so the upcoming controller migration can use Spring's slice-test
             support. Excludes the logging starter to align with the runtime
             dep above. JUnit 5 / Mockito / AssertJ / Awaitility transitives
             converge with our explicit declarations via Spring Boot's BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <!-- Bundle api/openapi.yaml into the JAR at static/openapi.yaml so
             Spring Boot's static-resource handler serves it at the URL
             /openapi.yaml (which Swagger UI is configured to load). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/api</directory>
                <targetPath>static</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- =========================================================
                 ENFORCER: fail fast on bad environments and dependency
                 conflicts. Critical for performance-sensitive code where
                 silent version drift causes subtle bugs.
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${enforcer.maven.version}</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>${enforcer.java.version}</version>
                                </requireJavaVersion>
                                <!-- Fail if the same artifact resolves to different versions
                                     across the dep tree. Catches classpath mismatches before
                                     they explode at runtime. -->
                                <dependencyConvergence/>
                                <!-- Block snapshot deps in release builds. -->
                                <requireReleaseDeps>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- =========================================================
                 AVRO CODEGEN
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>${avro.version}</version>
                <executions>
                    <execution>
                        <id>schema</id>
                        <phase>generate-sources</phase>
                        <goals><goal>schema</goal></goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/../kafka/schemas</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
                            <stringType>String</stringType>
                            <!-- Enable optional getters for cleaner null handling in consumers. -->
                            <gettersReturnOptional>false</gettersReturnOptional>
                            <createSetters>true</createSetters>
                            <!-- Fail the build on schema parse errors rather than skipping. -->
                            <fieldVisibility>private</fieldVisibility>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Register generated Avro sources for IDE discovery. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build.helper.version}</version>
                <executions>
                    <execution>
                        <id>add-avro-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/avro</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- =========================================================
                 COMPILER
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
                <configuration>
                    <!-- -parameters preserves method parameter names in bytecode,
                         useful for reflection-heavy libraries and better debugging. -->
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Xlint:-processing</arg>
                        <!-- Do not fail build on warnings from generated Avro sources.
                             Remove this if you want strictest warnings-as-errors. -->
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- =========================================================
                 UNIT TESTS (surefire): *Test.java, fast, no external deps
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} -Xmx512m -XX:+ExitOnOutOfMemoryError</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <!-- Fork per test class isolates leaked state (thread-local,
                         static caches) that can mask concurrency bugs. -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>

            <!-- =========================================================
                 INTEGRATION TESTS (failsafe): *IT.java, Testcontainers
                 Kept separate so `mvn test` stays fast for local dev loops.
                 Run integration tests with `mvn verify`.
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} -Xmx1g -XX:+ExitOnOutOfMemoryError</argLine>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- =========================================================
                 COVERAGE
                 ========================================================= -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <!-- Generated Avro classes: exclude from coverage. -->
                        <exclude>com/perf/orchestrator/avro/**</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- =========================================================
                 SHADE: fat JAR for the orchestrator container image.
                 ========================================================= -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <!-- Do NOT set <minimizeJar>true</minimizeJar>: it breaks
                                 reflective loading used by Kafka's ConfigDef (the very
                                 mechanism that loads KafkaAvroSerializer by class name)
                                 and by SLF4J binding discovery. Minimization in this
                                 project costs more bugs than it saves megabytes. -->

                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${app.main.class}</mainClass>
                                    <manifestEntries>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                                <!-- Merge META-INF/services/* from all jars. Critical for
                                     Kafka serializer discovery and SLF4J provider lookup. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Merge Avro SpecificData service files. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/services/org.apache.avro.specific.SpecificData</resource>
                                </transformer>
                                <!-- Merge Spring Boot 3.x auto-configuration imports. Without
                                     this, the shaded JAR carries only the LAST jar's imports
                                     file (last-jar-wins) and dozens of auto-config classes
                                     fail to register at boot — symptom: NoSuchBeanDefinitionException
                                     on MeterRegistry / KafkaTemplate / etc. when the
                                     orchestrator starts in a container.
                                     spring-boot-actuator + micrometer-registry-prometheus +
                                     spring-kafka all ship their own imports lines. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring/org.springframework.boot.actuate.autoconfigure.web.ManagementContextConfiguration.imports</resource>
                                </transformer>
                                <!-- Spring Boot 2.x → 3.x transition: a few libraries still
                                     ship spring.factories. Merge it too. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/spring.factories</resource>
                                </transformer>
                                <!-- Prevent duplicate LICENSE/NOTICE warnings in the merged JAR. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>

                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signature files must be stripped or the merged
                                             JAR fails SecurityException on startup. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- module-info duplication breaks on Java 17 when
                                             multiple dependencies ship Jigsaw descriptors. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Maven metadata bloat. -->
                                        <exclude>META-INF/maven/**</exclude>
                                        <!-- Cut source jars accidentally included. -->
                                        <exclude>**/*.java</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- =========================================================
         PROFILES
         ========================================================= -->
    <profiles>
        <!-- Skip integration tests by default in local dev; enable in CI. -->
        <profile>
            <id>skip-it</id>
            <activation>
                <property>
                    <name>skipITs</name>
                </property>
            </activation>
            <properties>
                <skipITs>true</skipITs>
            </properties>
        </profile>

        <!-- AWS S3 artifact-source backend (added in MIGRATION step 10).

             S3 is intentionally an *artifact source only* — RESULT_SINK=S3
             is rejected at config-load time. Source for S3ArtifactSource
             lives in src/main/java-storage-s3/ and is compiled only when
             this profile is active. The default fat JAR remains S3-free
             so air-gapped clusters and non-AWS deployments don't carry
             an unused 12+ MB SDK.

             Authentication is via AWS's default credentials chain
             (IAM instance profile on EC2; IRSA in EKS); credentials are
             never read from the request body. -->
        <profile>
            <id>storage-s3</id>
            <dependencies>
                <dependency>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>s3</artifactId>
                    <version>${aws.sdk.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-storage-s3-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/java-storage-s3</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-storage-s3-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java-storage-s3</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Document Service result-sink backend (added in MIGRATION step 9).

             Source for DocumentServiceResultSink lives in
             src/main/java-storage-docservice/ and is added to the build
             only when this profile is active. The default fat JAR is
             unaffected — important because the orchestrator runs in
             air-gapped clusters where the doc service isn't reachable.

             Implementation uses java.net.http.HttpClient — zero new
             direct dependencies. -->
        <profile>
            <id>storage-docservice</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-storage-docservice-source</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/main/java-storage-docservice</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-storage-docservice-test-source</id>
                                <phase>generate-test-sources</phase>
                                <goals><goal>add-test-source</goal></goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/test/java-storage-docservice</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- SECURITY S-14 — OWASP dependency CVE gate. Inert by default so the
             offline `mvn -o ...` flow is unaffected; activate online in CI:
               mvn -P securityScan verify
             First run downloads the NVD database (slow); speed it up with a key:
               mvn -P securityScan -DnvdApiKey=$NVD_API_KEY verify
             (request one at https://nvd.nist.gov/developers/request-an-api-key).
             Fails the build on any dependency with CVSS >= 7 (high/critical).
             NOTE: added offline — the scan itself has NOT been run in this
             environment; verify (and bump the plugin version to latest) on the
             first CI run. -->
        <profile>
            <id>securityScan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>9.2.0</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
