            "h": 20
          },
          "datasource": {
            "type": "grafana-oracle-datasource",
            "uid": "${DS_ORACLE}"
          },
          "targets": [
            {
              "refId": "A",
              "rawSql": "SELECT l.LABEL_KEY AS \"Label\", l.APPLICATION AS \"Application\", SUM(f.THROUGHPUT) AS \"Samples\", SUM(f.AVG_MS * f.THROUGHPUT) / NULLIF(SUM(f.THROUGHPUT), 0) AS \"Avg\", SUM(f.P90_MS * f.THROUGHPUT) / NULLIF(SUM(f.THROUGHPUT), 0) AS \"P90\", SUM(f.P95_MS * f.THROUGHPUT) / NULLIF(SUM(f.THROUGHPUT), 0) AS \"P95\", SUM(f.P99_MS * f.THROUGHPUT) / NULLIF(SUM(f.THROUGHPUT), 0) AS \"P99\", 100 * SUM(f.ERROR_COUNT) / NULLIF(SUM(f.THROUGHPUT), 0) AS \"Error%\", SUM(f.THROUGHPUT) / NULLIF(MAX(f.WINDOW_SECOND) - MIN(f.WINDOW_SECOND) + 15, 0) AS \"Throughput\" FROM CARDZATE_DB_GRAF.CPS_METRICS_H f JOIN CARDZATE_DB_GRAF.LABEL l ON l.LABEL_ID = f.LABEL_ID WHERE l.GROUP_ID = 'CPS' AND ('${application:raw}' = '__all__' OR l.APPLICATION = '${application:raw}') AND ('${label}' IS NULL OR l.LABEL_KEY LIKE TRIM('${label}') || '%') AND f.WINDOW_SECOND BETWEEN ${__from:date:seconds} AND ${__to:date:seconds} GROUP BY l.LABEL_KEY, l.APPLICATION ORDER BY \"Samples\" DESC",
              "format": "table"
            }
          ],
